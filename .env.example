APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# ⚠️ Pour tester sur un appareil physique (Pixel...), remplacer par
# http://<IP_LOCALE_DU_PC>:8000 — sinon les URLs générées pour les avatars,
# photos de biens et contrats PDF (Storage::url()) pointent vers "localhost",
# qui ne résout pas vers le PC depuis le téléphone.

# Abonnement plateforme (droits d'utilisation propriétaire, voir
# config/subscription.php) — valeur placeholder, à ajuster ici.
SUBSCRIPTION_AMOUNT=5000
SUBSCRIPTION_PERIOD_MONTHS=1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
 DB_HOST=127.0.0.1
 DB_PORT=3306
 DB_DATABASE=gestion_immo
 DB_USERNAME=root
 DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Gestion Locative — règle A.6.7 : rappel de paiement X jours avant échéance
PAYMENT_REMINDER_DAYS_BEFORE=5

# Sanctum — durée de vie des tokens API (7 jours), renouvelable via auth/refresh
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# CORS — origines autorisées, séparées par des virgules (l'app mobile Flutter n'envoie pas d'Origin)
CORS_ALLOWED_ORIGINS=

# Google Sign-In — Client ID OAuth Android du projet Firebase/Google Cloud
# (Console Firebase > Paramètres du projet > Général > Vos applications > Android)
GOOGLE_CLIENT_ID=
